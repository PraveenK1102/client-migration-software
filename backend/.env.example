# Backend configuration. Copy to backend/.env and fill in GROQ_API_KEY to run live.
# The API key is loaded from the environment / this file by the BACKEND ONLY.
# Never expose it to the frontend. Do NOT create a VITE_GROQ_API_KEY.

# --- Model provider ---
# "groq" for real hosted inference, or "fake" for the explicitly test/demo-only adapter.
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_KEY=

# --- Model call limits (initial configurable limits, not performance claims) ---
LLM_TIMEOUT_SECONDS=60
LLM_MAX_ATTEMPTS=3
LLM_MAX_CONCURRENCY=2

# --- Estimated AI cost (configurable per deployment; NEVER hard-coded in the UI) ---
# USD per 1,000,000 tokens. The estimated cost is computed server-side from the persisted token usage:
#   input_tokens/1e6 * LLM_PRICE_INPUT_PER_1M + output_tokens/1e6 * LLM_PRICE_OUTPUT_PER_1M
# Defaults track the published Groq openai/gpt-oss-20b rate; override per model/deployment.
LLM_PRICE_INPUT_PER_1M=0.10
LLM_PRICE_OUTPUT_PER_1M=0.50

# --- Ingestion limits (enforced while READING; an oversized file is REJECTED, never truncated) ---
MAX_UPLOAD_BYTES=5242880        # 5 MB per file
MAX_ROWS_PER_TABLE=5000         # hard per-table row cap; file at limit+1 is rejected, no partial rows
MAX_FILES_PER_JOB=10

# --- Observability / LangSmith model-call tracing (OPTIONAL; the app runs fully with tracing off) ---
# When a key is present AND tracing is on, the app emits one sanitized run_type="llm" span per model
# call (model, attempts, latency, token usage) plus LangGraph node traces. PII-safe: spans carry the
# redacted projection (headers + shape), NEVER the raw prompt/values or the key. Leave blank to disable.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=darwinbox-migration
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- M3A single-node runtime (all optional; defaults shown) ---
# SQLite is hardened (WAL + busy timeout + short transactions); LangGraph stays on AsyncSqliteSaver.
SQLITE_BUSY_TIMEOUT_MS=5000
# Bounded local worker pool that drains the durable SQLite work queue (NOT unbounded tasks).
MAX_FILE_WORKERS=4
WORK_LEASE_SECONDS=120          # a 'processing' item is reclaimable after this if the lease isn't renewed
WORK_MAX_ATTEMPTS=5
START_WORKERS=true             # the app lifespan starts the worker pool
# Mock target HR system (the reconciliation boundary; the migration only calls it via the gateway).
# Default: run it in-process behind an httpx ASGI transport (no port). Set false + a base URL to
# talk to a separately-running target service (scripts/run_target.py) or a real remote system.
TARGET_INPROCESS=true
TARGET_BASE_URL=http://127.0.0.1:8100
